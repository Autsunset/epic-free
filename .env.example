# ====================================================================
# Epic account
# If a value contains $, \, #, or ` (e.g. some passwords), wrap it in single
# quotes so python-dotenv keeps it as a literal: EPIC_PASSWORD='abc$def'.
# This only affects local .env files; GitHub Actions Secrets are unaffected.
# ====================================================================
EPIC_EMAIL=your_email@example.com
EPIC_PASSWORD=your_password

# ====================================================================
# LLM provider — pick ONE: openai | anthropic | gemini
# Only fill in the *_API_KEY for the provider you chose.
# If LLM_PROVIDER is left blank it is auto-detected from the keys below.
#
# GLM / ZhipuAI users: use openai with OPENAI_BASE_URL pointed at the GLM
# endpoint and OPENAI_MODEL set to a glm-* model. GLM-specific behaviour
# (raw-base64 images, thinking mode) is auto-detected from the model name.
# ====================================================================
LLM_PROVIDER=openai

# --- OpenAI (Chat Completions or Responses API) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Wire format: chat (default, works with any OpenAI-compatible relay) | responses
OPENAI_API_FORMAT=chat

# Example: GLM via OpenAI Chat format
# OPENAI_API_KEY=your_glm_key
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OPENAI_MODEL=glm-4.5v
# OPENAI_API_FORMAT=chat

# --- Anthropic (Messages API, Claude models) ---
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-sonnet-5

# --- Official Gemini (or AiHubMix relay) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_BASE_URL=          # leave empty for official Gemini; e.g. https://aihubmix.com
# GEMINI_MODEL=gemini-2.5-pro

# ====================================================================
# Optional per-task model overrides
# Leave empty to follow the chosen provider's default model automatically.
# ====================================================================
CHALLENGE_CLASSIFIER_MODEL=
IMAGE_CLASSIFIER_MODEL=
SPATIAL_POINT_REASONER_MODEL=
SPATIAL_PATH_REASONER_MODEL=

# ====================================================================
# Browser runtime
# Supported values: auto, camoufox, playwright
# ====================================================================
BROWSER_BACKEND=auto

# ====================================================================
# Local one-shot run (set true to disable the recurring scheduler)
# ====================================================================
ENABLE_APSCHEDULER=false
# HEADLESS=true

# ====================================================================
# Disk-artifact retention (days; 0 = keep forever)
# Each run deletes files older than this under volumes/.
# ====================================================================
# RECORD_RETENTION_DAYS=30     # browser video recordings (volumes/record)
# RUNTIME_RETENTION_DAYS=30    # debug screenshots + hcaptcha caches
